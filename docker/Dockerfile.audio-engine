FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY audio_engine/requirements.txt /app/audio_engine/requirements.txt
RUN pip install --no-cache-dir -r /app/audio_engine/requirements.txt \
    && pip install --no-cache-dir fastapi uvicorn python-multipart onnxruntime

COPY audio_engine /app/audio_engine

ENV PYTHONPATH=/app
EXPOSE 8003
CMD ["python", "-m", "uvicorn", "audio_engine.server:app", "--host", "0.0.0.0", "--port", "8003"]